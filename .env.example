# Copy to .env and fill in. Never commit .env.

PORT=3000

# SMTP account that sends the emails. Any provider works (Resend, Postmark,
# Brevo, Mailgun, Google Workspace...). Leave SMTP_HOST empty to run in
# preview mode: emails are printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender must be an address on a domain verified with your SMTP provider.
MAIL_FROM="Thommy Franklin website <no-reply@your-domain.com>"
# Where enquiries go.
MAIL_TO=contact@wildcardmanagement.com
# Email the enquirer a copy ("we got it"). true/false
SEND_CONFIRMATION=true

# Only needed if the site is hosted on a different domain than this API.
# Comma-separated, e.g. https://thommyfranklin.com,https://www.thommyfranklin.com
ALLOWED_ORIGINS=

# Set true behind a reverse proxy / most hosts (Render, Railway, Fly, nginx)
# so rate limiting sees the real visitor IP.
TRUST_PROXY=false

# Where submissions are logged (enquiries.jsonl). Defaults to ./data
DATA_DIR=
